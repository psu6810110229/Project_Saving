<?xml version="1.0" encoding="utf-8"?>
<!--
  Shell layout for the 4x2 React-captured widget.
  The ImageView is filled by WidgetRenderer with a bitmap captured from
  the React /widget/medium route. The card visual lives entirely in React.
  The whole widget taps to goout://dashboard (set in WidgetRenderer).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- fitXY: the captured card (aspect ~2.2:1, close to a 4x2 cell) fills the
         whole cell, so no background rectangle shows behind it. The card's own
         rounded corners are the only edge; the transparent corner triangles
         reveal the wallpaper. -->
    <ImageView
        android:id="@+id/w_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

</FrameLayout>
