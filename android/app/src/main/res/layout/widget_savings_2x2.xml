<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <TextView
        android:id="@+id/w_room"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/ibm_plex_sans_thai_semibold"
        android:maxLines="1"
        android:text="@string/app_name"
        android:textColor="@color/widget_ink_muted"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:baselineAligned="true"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/ibm_plex_sans_thai_semibold"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/w_due_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="2dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/ibm_plex_sans_thai_semibold"
            android:maxLines="1"
            android:textColor="@color/widget_brand_deep"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_support"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="@font/ibm_plex_sans_thai_regular"
        android:maxLines="1"
        android:textColor="@color/widget_ink_muted"
        android:textSize="10sp" />

    <ProgressBar
        android:id="@+id/w_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="9dp"
        android:max="100"
        android:progressDrawable="@drawable/widget_progress" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/w_add"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="@drawable/widget_btn_primary"
        android:fontFamily="@font/ibm_plex_sans_thai_semibold"
        android:gravity="center"
        android:text="@string/widget_add"
        android:textColor="@color/widget_surface"
        android:textSize="12sp" />
</LinearLayout>
