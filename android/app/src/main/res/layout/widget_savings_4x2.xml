<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:padding="16dp">

    <!-- LEFT: info section -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ibm_plex_sans_thai_semibold"
            android:textColor="@color/widget_ink_muted"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/w_saved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/ibm_plex_sans_thai_semibold"
            android:textColor="@color/widget_ink"
            android:textSize="24sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/w_savedsub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ibm_plex_sans_thai_regular"
            android:textColor="@color/widget_ink_muted"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Progress bar + percent -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/w_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:max="100"
                android:progressDrawable="@drawable/widget_progress" />

            <TextView
                android:id="@+id/w_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:fontFamily="@font/ibm_plex_mono_semibold"
                android:textColor="@color/widget_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_togo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/ibm_plex_sans_thai_regular"
            android:textColor="@color/widget_brand_deep"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- RIGHT: actions section -->
    <LinearLayout
        android:layout_width="124dp"
        android:layout_height="match_parent"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_streak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ibm_plex_mono_semibold"
            android:gravity="end"
            android:textColor="@color/widget_brand_deep"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/w_add"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/widget_btn_primary"
            android:fontFamily="@font/ibm_plex_sans_thai_semibold"
            android:gravity="center"
            android:textColor="@color/widget_surface"
            android:textSize="13sp"
            android:text="@string/widget_add" />

        <TextView
            android:id="@+id/w_check"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_btn"
            android:fontFamily="@font/ibm_plex_sans_thai_semibold"
            android:gravity="center"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"
            android:text="@string/widget_check" />
    </LinearLayout>
</LinearLayout>
