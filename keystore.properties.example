# Copy to keystore.properties (gitignored) and fill in real values to enable
# release signing. Generate the keystore with:
#
#   keytool -genkey -v -keystore goout-release.keystore \
#     -alias goout -keyalg RSA -keysize 2048 -validity 10000
#
# Keep goout-release.keystore and these passwords safe and backed up: losing
# them means you can no longer ship updates that overwrite an installed app.
# storeFile is resolved relative to the android/ project root.

storeFile=goout-release.keystore
storePassword=CHANGE_ME
keyAlias=goout
keyPassword=CHANGE_ME
