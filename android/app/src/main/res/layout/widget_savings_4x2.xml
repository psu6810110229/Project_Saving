<?xml version="1.0" encoding="utf-8"?>
<!--
  Shell layout for the 4x2 React-captured widget.
  The ImageView is filled by WidgetRenderer with a bitmap captured from
  the React /widget/medium route. The card visual lives entirely in React.
  The whole widget taps to goout://dashboard (set in WidgetRenderer).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- fitCenter: scale the captured card uniformly (no distortion) and centre
         it. A fixed-aspect bitmap can't fill an arbitrary device cell without
         either stretching (fitXY) or cropping, so we let it float: the card's
         baked-in rounded corners are the only edge, and the transparent margins
         reveal the wallpaper. Identical result on every launcher. -->
    <ImageView
        android:id="@+id/w_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

</FrameLayout>
